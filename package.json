    "sample-data": "node scripts/make-sample-data.ts"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^2.11.0",
    "@netlify/functions": "^2.8.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
